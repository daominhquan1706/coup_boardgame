{
  "name": "coup_boardgame_e2e",
  "private": true,
  "scripts": {
    "build:web": "fvm flutter build web --release --no-wasm-dry-run",
    "deploy:hosting": "npm run build:web && npx firebase-tools deploy --only hosting",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright": "^1.58.2"
  }
}
